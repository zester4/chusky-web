# URL of the Chusky Hono service. Next.js proxies /api/auth and /v1 to this
# origin, so browser requests remain first-party to the frontend domain.
CHUSKY_API_ORIGIN=http://localhost:8080
# Better Auth's browser client origin. In production this may be the public
# dashboard URL because Next proxies /api/auth/* to CHUSKY_API_ORIGIN.
NEXT_PUBLIC_AUTH_URL=http://localhost:8080
# Canonical public dashboard URL used for metadata, email links, and custom
# domain setup. Use the real HTTPS hostname in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Remote MCP endpoint shown in the organization/project onboarding panel.
NEXT_PUBLIC_CHUSKY_MCP_URL=https://chusky-mcp.adesrnd.workers.dev/mcp
# X OAuth setup is server-side only. Register this exact callback URL in the
# X Developer Portal and keep the client secret out of browser code.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://localhost:3000/api/x/oauth/callback
